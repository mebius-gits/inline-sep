# Node.js 22.13+ (uses built-in node:sqlite). Copy to .env if customization is needed.
PORT=3100
HOST=0.0.0.0
DB_PATH=data/orders.sqlite
# Optional on first boot only. Otherwise set a password at localhost:3000/admin.
# ADMIN_PASSWORD=choose-a-unique-password-at-least-12-characters
# Enable behind an HTTPS reverse proxy; keep false for local HTTP testing.
COOKIE_SECURE=false
